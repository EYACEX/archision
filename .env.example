DATABASE_URL=postgresql://propview:password@localhost:5432/propview
REDIS_URL=redis://localhost:6379
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Office kiosk mode — enables high-quality rendering, local assets
OFFICE_MODE=false
ASSETS_PATH=./assets

# Shared key sales agents' tools send as `Authorization: Bearer <key>` to change unit status.
# Placeholder until real agent auth exists. Writes are refused if unset.
AGENT_API_KEY=change-me

# Python used by the DXF import (needs ezdxf: npm run parser:install). Defaults to `python` on PATH.
# PYTHON_BIN=C:\Python312\python.exe
