{
  "name": "propview-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit generate && drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "import:dxf": "tsx src/scripts/import-dxf.ts",
    "import:ifc": "tsx src/scripts/import-ifc.ts",
    "model:attach": "tsx src/scripts/attach-model.ts",
    "parser:install": "python -m pip install -r src/services/parser/requirements.txt",
    "samples:dxf": "python src/services/parser/make_sample_dxf.py samples"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "express": "^4.21.0",
    "ioredis": "^5.11.1",
    "pg": "^8.13.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
